# Backend Environment Variables
PROJECT_NAME="AICMS - AICTE Integrated Case Monitoring System"
SECRET_KEY="replace_with_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: Use SQLite for local test or PostgreSQL for Render/Docker/Neon
DATABASE_URL="sqlite:///./nivaran.db"
# DATABASE_URL="postgresql://user:password@hostname:5432/nivarandb"

# Google Gemini API (AI grievance triage, smart summary, and priority recommendation)
GEMINI_API_KEY="your_gemini_api_key_here"

# SLA Configuration
DEFAULT_SLA_DAYS=14

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Optional Email SMTP (If unset, dev mode logs safe mock notifications without complaints details)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="notifications@nivaran.gov.in"
